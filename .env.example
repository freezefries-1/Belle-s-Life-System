# Copy to .env.local (never commit real values) and fill in from
# Supabase → Project Settings → API. Leave both empty to keep the app in
# browser-only mode (no sign-in, data saved in this browser).

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The public "publishable" key (sb_publishable_...). Older projects: the "anon" key works too —
# set NEXT_PUBLIC_SUPABASE_ANON_KEY instead. Both are safe in the browser; Row Level Security protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Never add the service_role / secret key to this app.
